on early-init
    exec - root radio -- /vendor/bin/tee.sh

on post-fs && property:vendor.teegris.old=true
    mount none /vendor/etc/tee_old /vendor/tee bind
    mount none /vendor/lib64/libhwvault_15.so /vendor/lib64/libhwvault.so bind 
    mount none /vendor/lib64/libril_sem_15.so /vendor/lib64/libril_sem.so bind 
    mount none /vendor/lib64/libsec-ril_15.so /vendor/lib64/libsec-ril.so bind 
    mount none /vendor/lib64/libVendorSemTelephonyProps_15.so /vendor/lib64/libVendorSemTelephonyProps.so bind 
