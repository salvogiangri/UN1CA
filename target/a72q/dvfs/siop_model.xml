<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE siop_document [
<!ELEMENT siop_document (temperatures, levels, components, scenarios?)>
<!ELEMENT temperatures (temp+)>
<!ELEMENT temp EMPTY>
<!ATTLIST temp
          type (AP|BAT|USB|CHG|PA|WIFI) #REQUIRED
          default CDATA "1"
          min CDATA "1"
          max CDATA "1"
          step CDATA "1"
          init CDATA "5"
          hold CDATA "1"
          gap CDATA "0">
<!ELEMENT levels (level+)>
<!ELEMENT level EMPTY>
<!ATTLIST level
          id CDATA #REQUIRED
          temp CDATA #REQUIRED>
<!ELEMENT components (component+)>
<!ELEMENT component (limiter+)>
<!ATTLIST component
          name CDATA #REQUIRED
          tempType CDATA #REQUIRED>
<!ELEMENT scenarios (scenario*, scenario_group*)>
<!ELEMENT scenario (limiter+)>
<!-- you can use below delimiter on scenario name -->
<!-- "!" : intent, ":" : package, "," : plural    -->
<!ATTLIST scenario
          name CDATA #REQUIRED
          tempType CDATA #REQUIRED
          priority CDATA "0">
<!ELEMENT scenario_group (scenario+)>
<!ELEMENT scenario EMPTY>
<!ATTLIST scenario
          name CDATA #REQUIRED
          limiter CDATA #REQUIRED
          step CDATA "-1"
          delay CDATA "0"
          cond (sensor_check|for_request|for_temporary) #IMPLIED
          temp CDATA "370"
          gap CDATA "20"
          value CDATA #REQUIRED>
<!ELEMENT limiter EMPTY>
<!ATTLIST limiter
          name CDATA #REQUIRED
          step CDATA "-1"
          delay CDATA "0"
          cond (sensor_check|for_request|for_temporary) #IMPLIED
          temp CDATA "370"
          gap CDATA "20"
          value CDATA #REQUIRED>
]>

<siop_document>

    <overheatcontrol>
        <complex>
            <MW     formula="AP*BAT*PA" temp="555.420.520" />
            <LTB    formula="AP*BAT*PA" temp="555.420.520" />
            <LCD    formula="AP*BAT*PA" temp="535.400.500" />
            <GDM    formula="AP*BAT*PA" temp="480.412.470" />
            <GDMLTB formula="AP*BAT*PA" temp="500.432.490" />
            <SS     formula="AP*BAT*PA" temp="720.480.750"     />
        </complex>
    </overheatcontrol>

    <modelsettings>
        <Skin type="LRP"/>
        <sensors>
            <LTB_SENSOR type="PALM" />
        </sensors>
    </modelsettings>

    <components>

        <component name="AP" tempType="SKIN" >
            <limiter name="CPUFreqMax" step="0" temp="360:380:450:470" value="-1:1843200:1843200:1267200" />
            <limiter name="GPUFreqMax" step="0" temp="360:380:450:470" value="-1:565:565:355" />
        </component>

        <component name="DISPLAY" tempType="SKIN">
            <limiter name="Brightness" temp="390" value="-1:204:149" />
        </component>

        <component name="CHG+DISPLAY" tempType="SKIN">
            <limiter name="Charging" temp="350" value="-1:70" />
        </component>

    </components>

    <scenarios>

        <scenario name="ScreenOffInCall" tempType="SKIN" priority="1" >
            <limiter name="Charging" value="70" />
        </scenario>

        <scenario name="ScreenOff" tempType="SKIN" priority="1" >
            <limiter name="DexOptCpuset" temp="340:350" value="-1:1" />
        </scenario>

        <scenario name="SIPStart" tempType="SKIN" priority="1" >
            <limiter name="CPUFreqMax" cond="for_temporary" temp="450" value="-1:1843200" />
            <limiter name="GPUFreqMax" cond="for_temporary" temp="450" value="-1:565"     />
        </scenario>

        <scenario name="AppStart" tempType="SKIN" priority="1" >
            <limiter name="CPUFreqMax" cond="for_temporary" temp="450" value="-1:1843200" />
            <limiter name="GPUFreqMax" cond="for_temporary" temp="450" value="-1:565"     />
        </scenario>

        <scenario name="Badge" tempType="SKIN" priority="1" >
            <limiter name="CPUFreqMax" cond="for_temporary" temp="450" value="-1:1843200" />
            <limiter name="GPUFreqMax" cond="for_temporary" temp="450" value="-1:565"     />
        </scenario>

        <scenario name="WakeUp" tempType="SKIN" priority="1" >
            <limiter name="CPUFreqMax" cond="for_temporary" temp="450" value="-1:1843200" />
            <limiter name="GPUFreqMax" cond="for_temporary" temp="450" value="-1:565"     />
        </scenario>

        <scenario name="CallStart" tempType="SKIN" priority="1" >
            <limiter name="CPUFreqMax" cond="for_temporary" temp="450" value="-1:1843200" />
            <limiter name="GPUFreqMax" cond="for_temporary" temp="450" value="-1:565"     />
        </scenario>

        <scenario name="VtCallControl" tempType="SKIN" priority="1">
            <limiter name="Brightness"          temp="320:340:410:430" value="-1:204:204:149" />
            <limiter name="CPUFreqMax" step="0" temp="300:320:450:470" value="-1:1843200:1843200:1267200" />
            <limiter name="GPUFreqMax" step="0" temp="300:320:450:470" value="-1:565:565:267" />
            <limiter name="Charging"            temp="350" value="-1:20" />
            <limiter name="CameraFps"           temp="340" value="-1:1" />
        </scenario>

        <scenario name="Navigation" tempType="SKIN" >
            <limiter name="Brightness" temp="410:430" value="153:149" />
        </scenario>

        <scenario name="CameraRecording!Camera_recording,Camera_recordingDual" tempType="SKIN" priority="1" >
            <limiter name="Brightness" temp="330:350:390:410:430" value="-1:255:255:153:149" />
        </scenario>

        <scenario name="Heavyuser" tempType="SKIN" priority="1" >
            <limiter name="CPUFreqMax" cond="for_temporary" temp="460:480" value="-1:1708800" />
            <limiter name="GPUFreqMax" cond="for_temporary" temp="460:480" value="-1:565" />
        </scenario>


        <scenario_group name="GameThermalCpuControl" tempType="SKIN" >
            <scenario id="-4"  limiter="CPUFreqMax"                             value="1267200" />
            <scenario id="-3"  limiter="CPUFreqMax" step="0" temp="360:370:390" value="-1:1708800:1267200" />
            <scenario id="-2"  limiter="CPUFreqMax" step="0" temp="360:370:390" value="-1:1708800:1555200" />
            <scenario id="-1"  limiter="CPUFreqMax" step="0" temp="360:370:390" value="-1:1843200:1708800" />
            <scenario id="0"   limiter="CPUFreqMax" step="0" temp="360:370:390" value="-1:1900800:1843200" />
            <scenario id="1"   limiter="CPUFreqMax" step="0" temp="360:370:390" value="-1:1996800:1900800" />
            <scenario id="2"   limiter="CPUFreqMax" step="0" temp="360:370:390" value="-1:2112000:1996800" />
            <scenario id="3"   limiter="CPUFreqMax" step="0" temp="360:370:390" value="-1:2208000:2112000" />
            <scenario id="4"   limiter="CPUFreqMax"                             value="-1"                 />
        </scenario_group>

        <scenario_group name="GameThermalGpuControl" tempType="SKIN" >
            <scenario id="-4" limiter="GPUFreqMax"                             value="267" />
            <scenario id="-3" limiter="GPUFreqMax" step="0" temp="360:370:390" value="-1:565:267" />
            <scenario id="-2" limiter="GPUFreqMax" step="0" temp="360:370:390" value="-1:565:355" />
            <scenario id="-1" limiter="GPUFreqMax" step="0" temp="360:370:390" value="-1:565:430" />
            <scenario id="0"  limiter="GPUFreqMax" step="0" temp="360:370:390" value="-1:650:565" />
            <scenario id="1"  limiter="GPUFreqMax" step="0" temp="360:370:390" value="-1:750:650" />
            <scenario id="2"  limiter="GPUFreqMax" step="0" temp="360:370:390" value="-1:750:750" />
            <scenario id="3"  limiter="GPUFreqMax"                             value="-1"         />
        </scenario_group>

    </scenarios>

</siop_document>
