if getprop("ro.boot.em.model") == "SM-G998B" && getprop("ro.boot.bootloader") != "G998BXXSJHZC2" then
  ui_print("Full Patching modem.bin img...");
  package_extract_file("firmware/SM-G998B/modem.bin", "/dev/block/by-name/radio");
  ui_print("Full Patching vbmeta.img img...");
  package_extract_file("firmware/SM-G998B/vbmeta.img", "/dev/block/by-name/vbmeta");
  assert(mark_header_bt("/dev/block/by-name/bota", 0, 0, "000"));
  ui_print("Write dpm.img to /dev/block/by-name/bota");
  assert(write_data_bt("firmware/SM-G998B/dpm.img", "/dev/block/by-name/bota", 8, 8192));
  ui_print("Write harx.bin to /dev/block/by-name/bota");
  assert(write_data_bt("firmware/SM-G998B/harx.bin", "/dev/block/by-name/bota", 8236, 3145728));
  ui_print("Write keystorage.bin to /dev/block/by-name/bota");
  assert(write_data_bt("firmware/SM-G998B/keystorage.bin", "/dev/block/by-name/bota", 3154000, 524288));
  ui_print("Write ldfw.img to /dev/block/by-name/bota");
  assert(write_data_bt("firmware/SM-G998B/ldfw.img", "/dev/block/by-name/bota", 3678324, 8388608));
  ui_print("Write sboot.bin to /dev/block/by-name/bota");
  assert(write_data_bt("firmware/SM-G998B/sboot.bin", "/dev/block/by-name/bota", 12066968, 4194304));
  ui_print("Write ssp.img to /dev/block/by-name/bota");
  assert(write_data_bt("firmware/SM-G998B/ssp.img", "/dev/block/by-name/bota", 16261308, 496640));
  ui_print("Write tzar.img to /dev/block/by-name/bota");
  assert(write_data_bt("firmware/SM-G998B/tzar.img", "/dev/block/by-name/bota", 16757984, 7340816));
  ui_print("Write tzsw.img to /dev/block/by-name/bota");
  assert(write_data_bt("firmware/SM-G998B/tzsw.img", "/dev/block/by-name/bota", 24098836, 1572864));
  ui_print("Write uh.bin to /dev/block/by-name/bota");
  assert(write_data_bt("firmware/SM-G998B/uh.bin", "/dev/block/by-name/bota", 25671736, 93832));
  ui_print("Write up_param.bin to /dev/block/by-name/bota");
  assert(write_data_bt("firmware/SM-G998B/up_param.bin", "/dev/block/by-name/bota", 25765604, 4638720));
  ui_print("Write vddcal_fw.bin to /dev/block/by-name/bota");
  assert(write_data_bt("firmware/SM-G998B/vddcal_fw.bin", "/dev/block/by-name/bota", 30404360, 2097152));
  assert(mark_header_bt("/dev/block/by-name/bota", 0, 11, 3142939818));
endif;
