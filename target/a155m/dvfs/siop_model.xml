<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE siop_document [
<!ELEMENT siop_document (temperatures, levels, components, scenarios?)>
<!ELEMENT temperatures (temp+)>
<!ELEMENT temp EMPTY>
<!ATTLIST temp
          type (AP|BAT|USB|CHG|PA|WIFI) #REQUIRED
          default CDATA "1"
          min CDATA "1"
          max CDATA "1"
          step CDATA "1"
          init CDATA "5"
          hold CDATA "1"
          gap CDATA "0">
<!ELEMENT levels (level+)>
<!ELEMENT level EMPTY>
<!ATTLIST level
          id CDATA #REQUIRED
          temp CDATA #REQUIRED>
<!ELEMENT components (component+)>
<!ELEMENT component (limiter+)>
<!ATTLIST component
          name CDATA #REQUIRED
          tempType CDATA #REQUIRED>
<!ELEMENT scenarios (scenario*, scenario_group*)>
<!ELEMENT scenario (limiter+)>
<!ATTLIST scenario
          name CDATA #REQUIRED
          tempType CDATA #REQUIRED
          priority CDATA "0">
<!ELEMENT scenario_group (scenario+)>
<!ELEMENT scenario EMPTY>
<!ATTLIST scenario
          name CDATA #REQUIRED
          limiter CDATA #REQUIRED
          step CDATA "-1"
          delay CDATA "0"
          cond (sensor_check|for_request|for_temporary) #IMPLIED
          temp CDATA "370"
          gap CDATA "20"
          value CDATA #REQUIRED>
<!ELEMENT limiter EMPTY>
<!ATTLIST limiter
          name CDATA #REQUIRED
          step CDATA "-1"
          delay CDATA "0"
          cond (sensor_check|for_request|for_temporary) #IMPLIED
          temp CDATA "370"
          gap CDATA "20"
          value CDATA #REQUIRED>
]>

<siop_document>

    <overheatcontrol>
        <complex>
            <MW     formula="AP*BAT*PA" temp="530.430.520" />
            <LTB    formula="AP*BAT*PA" temp="530.430.520" />
            <LCD    formula="AP*BAT*PA" temp="505.405.490" />
            <GDM    formula="AP*BAT*PA" temp="465.430.470" />
            <GDMLTB formula="AP*BAT*PA" temp="490.455.490" />
            <SS     formula="AP*BAT*PA" temp="730.515.720" />
        </complex>
    </overheatcontrol>

    <modelsettings>
        <Skin type="MT6789"/> <sensors>
            <LTB_SENSOR type="PALM" />
        </sensors>
    </modelsettings>

    <components>

        <component name="AP" tempType="SKIN" >
            <limiter name="CPUFreqMax" step="0" temp="360:380:450:470" value="-1:2000000:2000000:1508000" />
            <limiter name="GPUFreqMax" step="0" temp="360:380:450:470" value="-1:800:800:500" />
        </component>

        <component name="DISPLAY" tempType="SKIN">
            <limiter name="Brightness" temp="390" value="-1:204:149" />
        </component>

        <component name="CP" tempType="SKIN">
            <limiter name="DLThrot" temp="410:430" value="-1:2" />
            <limiter name="CpLowMode" temp="340:360" value="-1:2" />
            <limiter name="SADisable" temp="420" value="-1:1" />
        </component>

        <component name="CHG+DISPLAY" tempType="SKIN">
            <limiter name="Charging" temp="350" value="-1:70" />
        </component>

    </components>

    <scenarios>

        <scenario name="ScreenOffInCall" tempType="SKIN" priority="1" >
            <limiter name="Charging" value="70" />
        </scenario>

        <scenario name="AppStart" tempType="SKIN" priority="1" >
            <limiter name="CPUFreqMax" cond="for_temporary" temp="450" value="-1:2200000" />
            <limiter name="GPUFreqMax" cond="for_temporary" temp="450" value="-1:950"     />
        </scenario>

        <scenario name="VtCallControl" tempType="SKIN" priority="1">
            <limiter name="Brightness" temp="320:340:410:430" value="-1:204:204:149" />
            <limiter name="Charging"   temp="320:340" value="-1:70" />
            <limiter name="CPUFreqMax" step="0" temp="360:380:400:420" value="-1:2000000:2000000:1508000" />
        </scenario>

        <scenario name="CameraRecording!Camera_recording,Camera_recordingDual" tempType="SKIN">
            <limiter name="Brightness" temp="330:350:390:410:430" value="-1:255:255:204:149" />
        </scenario>

        <scenario_group name="GameThermalCpuControl" tempType="SKIN" >
            <scenario id="-4"  limiter="CPUFreqMax"                             value="1014000" />
            <scenario id="0"   limiter="CPUFreqMax" step="0" temp="360:370:390" value="-1:2000000:1800000" />
            <scenario id="2"   limiter="CPUFreqMax" step="0" temp="360:370:390" value="-1:2200000:2000000" />
            <scenario id="4"   limiter="CPUFreqMax"                             value="-1"                 />
        </scenario_group>

        <scenario_group name="GameThermalGpuControl" tempType="SKIN" >
            <scenario id="-1" limiter="GPUFreqMax" step="0" temp="360:370:390"  value="-1:800:500" />
            <scenario id="0"  limiter="GPUFreqMax" step="0" temp="360:370:390"  value="-1:950:800" />
            <scenario id="1"  limiter="GPUFreqMax"                              value="-1" />
        </scenario_group>

    </scenarios>

</siop_document>
