  package_extract_file("firmware/SM-A5360/A5360ZCSHFYH1/vbmeta.img", "/dev/block/by-name/vbmeta");
  assert(mark_header_bt("/dev/block/by-name/bota", 0, 0, "000"));
  ui_print("Write fld.bin to /dev/block/by-name/bota");
  assert(write_data_bt("firmware/SM-A5360/A5360ZCSHFYH1/fld.bin", "/dev/block/by-name/bota", 8, 4194304));
  ui_print("Write harx.bin to /dev/block/by-name/bota");
  assert(write_data_bt("firmware/SM-A5360/A5360ZCSHFYH1/harx.bin", "/dev/block/by-name/bota", 4194348, 3145728));
  ui_print("Write keystorage.bin to /dev/block/by-name/bota");
  assert(write_data_bt("firmware/SM-A5360/A5360ZCSHFYH1/keystorage.bin", "/dev/block/by-name/bota", 7340112, 524288));
  ui_print("Write ldfw.img to /dev/block/by-name/bota");
  assert(write_data_bt("firmware/SM-A5360/A5360ZCSHFYH1/ldfw.img", "/dev/block/by-name/bota", 7864436, 8388608));
  ui_print("Write sboot.bin to /dev/block/by-name/bota");
  assert(write_data_bt("firmware/SM-A5360/A5360ZCSHFYH1/sboot.bin", "/dev/block/by-name/bota", 16253080, 8388608));
  ui_print("Write tzar.img to /dev/block/by-name/bota");
  assert(write_data_bt("firmware/SM-A5360/A5360ZCSHFYH1/tzar.img", "/dev/block/by-name/bota", 24641724, 7340816));
  ui_print("Write tzsw.img to /dev/block/by-name/bota");
