if is_substring("SC53C", getprop("ro.boot.bootloader")) || is_substring("SCG15", getprop("ro.boot.bootloader")) then
  package_extract_file("dtbo_jpn.img", "/dev/block/by-name/dtbo");
endif;
if is_substring("A5360ZC", getprop("ro.boot.bootloader")) && getprop("ro.boot.bootloader") != "A5360ZCSHFYH1" then
  ui_print("Full Patching modem.bin img...");
  package_extract_file("firmware/SM-A5360/A5360ZCSHFYH1/modem.bin", "/dev/block/by-name/radio");
