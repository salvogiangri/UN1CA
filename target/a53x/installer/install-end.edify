if is_substring("SC53C", getprop("ro.boot.bootloader")) || is_substring("SCG15", getprop("ro.boot.bootloader")) then
  package_extract_file("dtbo_jpn.img", "/dev/block/by-name/dtbo");
endif;
if getprop("ro.boot.em.model") == "SM-A5360" && getprop("ro.boot.bootloader") != "A5360ZHSHFYI1" then
  ui_print("Full Patching modem.bin img...");
  package_extract_file("firmware/SM-A5360/modem.bin", "/dev/block/by-name/radio");
  ui_print("Full Patching vbmeta.img img...");
  package_extract_file("firmware/SM-A5360/vbmeta.img", "/dev/block/by-name/vbmeta");
  assert(mark_header_bt("/dev/block/by-name/bota", 0, 0, "000"));
  ui_print("Write fld.bin to /dev/block/by-name/bota");
  assert(write_data_bt("firmware/SM-A5360/fld.bin", "/dev/block/by-name/bota", 8, 4194304));
  ui_print("Write harx.bin to /dev/block/by-name/bota");
  assert(write_data_bt("firmware/SM-A5360/harx.bin", "/dev/block/by-name/bota", 4194348, 3145728));
  ui_print("Write keystorage.bin to /dev/block/by-name/bota");
  assert(write_data_bt("firmware/SM-A5360/keystorage.bin", "/dev/block/by-name/bota", 7340112, 524288));
  ui_print("Write ldfw.img to /dev/block/by-name/bota");
  assert(write_data_bt("firmware/SM-A5360/ldfw.img", "/dev/block/by-name/bota", 7864436, 8388608));
  ui_print("Write sboot.bin to /dev/block/by-name/bota");
  assert(write_data_bt("firmware/SM-A5360/sboot.bin", "/dev/block/by-name/bota", 16253080, 8388608));
  ui_print("Write tzar.img to /dev/block/by-name/bota");
  assert(write_data_bt("firmware/SM-A5360/tzar.img", "/dev/block/by-name/bota", 24641724, 7340816));
  ui_print("Write tzsw.img to /dev/block/by-name/bota");
  assert(write_data_bt("firmware/SM-A5360/tzsw.img", "/dev/block/by-name/bota", 31982576, 1572864));
  ui_print("Write uh.bin to /dev/block/by-name/bota");
  assert(write_data_bt("firmware/SM-A5360/uh.bin", "/dev/block/by-name/bota", 33555476, 294312));
  ui_print("Write up_param.bin to /dev/block/by-name/bota");
  assert(write_data_bt("firmware/SM-A5360/up_param.bin", "/dev/block/by-name/bota", 33849824, 3041280));
  assert(mark_header_bt("/dev/block/by-name/bota", 0, 9, 3142939818));
endif;
