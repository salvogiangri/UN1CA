<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE siop_document [
<!ELEMENT siop_document (temperatures, levels, components, scenarios?)>
<!ELEMENT temperatures (temp+)>
<!ELEMENT temp EMPTY>
<!ATTLIST temp
          type (AP|BAT|USB|CHG|PA|WIFI) #REQUIRED
          default CDATA "1"
          min CDATA "1"
          max CDATA "1"
          step CDATA "1"
          init CDATA "5"
          hold CDATA "1"
          gap CDATA "0">
<!ELEMENT levels (level+)>
<!ELEMENT level EMPTY>
<!ATTLIST level
          id CDATA #REQUIRED
          temp CDATA #REQUIRED>
<!ELEMENT components (default, complex?)>
<!ELEMENT default (component+)>
<!ELEMENT complex (component+)>
<!ELEMENT component (limiter+)>
<!ATTLIST component
          name CDATA #REQUIRED
          tempType CDATA #REQUIRED>
<!ELEMENT scenarios (scenario*, scenario_group*)>
<!ELEMENT scenario (limiter+)>
<!-- you can use below delimiter on scenario name -->
<!-- "!" : intent, ":" : package, "," : plural    -->
<!ATTLIST scenario
          name CDATA #REQUIRED
          tempType CDATA #REQUIRED
          priority CDATA "0">
<!ELEMENT scenario_group (scenario+)>
<!ELEMENT scenario EMPTY>
<!ATTLIST scenario
          name CDATA #REQUIRED
          limiter CDATA #REQUIRED
          step CDATA "-1"
          delay CDATA "0"
          cond (sensor_check|for_request|for_temporary) #IMPLIED
          temp CDATA "370"
          gap CDATA "20"
          value CDATA #REQUIRED>
<!ELEMENT limiter EMPTY>
<!ATTLIST limiter
          name CDATA #REQUIRED
          step CDATA "-1"
          delay CDATA "0"
          cond (sensor_check|for_request|for_temporary) #IMPLIED
          temp CDATA "370"
          gap CDATA "20"
          value CDATA #REQUIRED>
]>

<siop_document>

    <overheatcontrol>
        <complex>
            <LTB formula="AP*BAT*LRP" temp="560.460.450" />
            <SS  formula="AP*BAT*PA*LRP" temp="550.470.550.450" />
            <GDM formula="AP*BAT*LRP" temp="480.460.430" delta="10"/>
            <GDMLTB formula="AP*BAT*LRP" temp="510.490.450"/>
            <DEX formula="AP*BAT" temp="570.440" />
        </complex>
    </overheatcontrol>

    <modelsettings>
        <Skin type="AP"/>
        <temperatures>
            <temp type="AP"   default="15" min="15" max="15" step="0" gap="110" />
        </temperatures>
        <levels>
            <level id="-3" temp="410" />
            <level id="-2" temp="430" />
            <level id="-1" temp="450" />
            <level id="0"  temp="470" />
            <level id="1"  temp="490" />
            <level id="2"  temp="510" />
            <level id="3"  temp="530" />
            <level id="4"  temp="550" />
            <level id="5"  temp="570" />
        </levels>
        <releaseSTS temp="350" />
        <sensors>
            <LTB_SENSOR type="(PALM*LIGHT*RPROXY)+(POSITION*LIGHT*RPROXY)" />
        </sensors>
    </modelsettings>

    <components>

        <component name="AP" tempType="AP" >
            <limiter name="CPUFreqMax" step="0" temp="460:470:490" value="-1:1664000:1378000" />
            <limiter name="GPUFreqMax" step="0" temp="460:470:490" value="-1:433000:377000" />
            <limiter name="AppInstallDelay" value="5000" />
            <limiter name="BackgroundCpuset" temp="470" gap="20" value="-1:100:200:300" />
            <limiter name="TABoost"      temp="510" value="-1:1" />
        </component>

        <component name="CHG" tempType="AP">
            <limiter name="Charging" value="-1" />
        </component>

        <component name="DISPLAY" tempType="AP*LRP">
            <limiter name="Brightness" temp="500.390:520.410:540.430" value="-1:201:144" />
            <limiter name="MultiWindow" temp="560.450:580.470:610.500" value="-1:1:1" delay="0:300:0" />
        </component>

        <component name="WIFI" tempType="AP">
            <limiter name="WifiTput" temp="480" gap="20" value="-1:50:30:10" />
            <limiter name="SmartBonding" temp="510" value="-1:1" />
        </component>

        <component name="CAM" tempType="AP">
            <limiter name="DualRecording" temp="460" value="-1:1" />
        </component>

        <component name="AP+DISPLAY" tempType="AP" >
            <limiter name="AppInstallDelay" temp="410" gap="20" value="-1:3000:5000" />
        </component>

        <component name="CHG+DISPLAY" tempType="AP*BAT">
            <limiter name="Charging" temp="0.310:330.330" value="-1:70" />
        </component>

    </components>

    <scenarios>

        <scenario name="ScreenOff" tempType="AP" priority="1" >
            <limiter name="Charging" value="100" />
        </scenario>

        <scenario name="ScreenOffInCall" tempType="AP" priority="1">
            <limiter name="Charging" value="70" />
        </scenario>

        <scenario name="TPBoost:com.FTATS" tempType="AP" >
            <limiter name="CPUFreqMax" value="-1" />
        </scenario>

        <scenario name="Heavyuser" tempType="AP" priority="1" >
            <limiter name="CPUFreqMax" cond="for_temporary" temp="500" value="-1" />
            <limiter name="GPUFreqMax" cond="for_temporary" temp="500:560" value="-1:572000" />
        </scenario>

        <scenario name="AppStore" tempType="AP" >
            <limiter name="WifiTput" temp="420:440:460:500:520:540" value="-1:150:100:50:30:10" />
        </scenario>

        <scenario name="AppStart" tempType="AP" priority="2" >
            <limiter name="CPUFreqMax" cond="for_temporary" temp="550:600:620" value="-1:1378000:1248000" />
            <limiter name="GPUFreqMax" cond="for_temporary" temp="550:600"     value="-1:377000" />
        </scenario>

        <scenario name="Badge" tempType="AP" priority="2" >
            <limiter name="CPUFreqMax" cond="for_temporary" temp="550:600:620" value="-1:1378000:1248000" />
            <limiter name="GPUFreqMax" cond="for_temporary" temp="550:600"     value="-1:377000" />
        </scenario>

        <scenario name="WakeUp" tempType="AP" priority="2" >
            <limiter name="CPUFreqMax" cond="for_temporary" temp="550:600:620" value="-1:1378000:1248000" />
            <limiter name="GPUFreqMax" cond="for_temporary" temp="550:600"     value="-1:377000" />
        </scenario>

        <scenario name="LowTemp" tempType="BAT" priority="3" >
            <limiter name="CPUFreqMax" temp="-150:-70:-50" value="1664000:1976000:-1" />
        </scenario>

        <scenario name="Navigation" tempType="AP" >
            <limiter name="Brightness" temp="520:540" value="193:144" />
        </scenario>

        <scenario name="MultiWindow" tempType="LRP" priority="1">
            <limiter name="CPUFreqMax" step="0" temp="350"     value="-1:1560000:1560000:1144000:936000" />
        </scenario>

        <scenario name="Dex" tempType="SKIN*LRP" priority="1">
            <limiter name="CPUFreqMax" step="0" temp="460.350:480.370:500.390:520.410:540.430"     value="-1:1560000:1560000:1144000:936000" />
            <limiter name="DynamicFpsLevel"     temp="520.410:540.430"                             value="-1:30"/>
        </scenario>

        <scenario name="VtCallControl" tempType="AP" priority="1">
            <limiter name="Brightness" temp="520:540" value="201:144" />
            <limiter name="CameraFps"       temp="360" value="-1:1" />
        </scenario>

        <scenario name="LiveCam" tempType="AP" priority="1">
            <limiter name="Brightness" temp="520:540" value="201:144" />
            <limiter name="CameraFps"       temp="360" value="-1" />
        </scenario>

        <scenario name="SpayClockLimit" tempType="AP" priority="2" >
            <limiter name="CPUFreqMax" temp="470" value="2080000:1664000:1378000" />
        </scenario>

        <scenario name="OTG" tempType="AP" priority="2" >
            <limiter name="CPUFreqMax" temp="470" value="2080000:1664000:1378000" />
        </scenario>

        <scenario name="PowerSharing" tempType="AP" priority="3" >
            <limiter name="CPUFreqMax" temp="490" value="1560000:1378000" />
            <limiter name="GPUFreqMax" value="377000" />
        </scenario>

        <scenario name="CameraNight!Camera_night" tempType="AP">
            <limiter name="CPUFreqMax" value="-1" />
            <limiter name="GPUFreqMax" value="-1" />
        </scenario>

        <scenario name="CameraRecording!Camera_recording,Camera_recordingDual" tempType="AP">
            <limiter name="Brightness" temp="440:460:500:520:540" value="-1:255:255:201:144" />
        </scenario>

        <scenario name="ARemoji:com.samsung.android.aremoji" tempType="AP" >
            <limiter name="GPUFreqMax" value="377000" />
        </scenario>

        <scenario name="SmartSwitch" tempType="AP" >
            <limiter name="CPUFreqMax" step="0" temp="460:470:490" value="2236000:1664000:1378000" />
        </scenario>

        <scenario name="DimmingGameRestriction" tempType="AP" priority="2" >
            <limiter name="CPUFreqMax" value="728000" />
            <limiter name="GPUFreqMax" value="260000" />
            <limiter name="Brightness" value="50" />
        </scenario>

        <scenario name="MaxDimmingGameRestriction" tempType="AP" priority="2" >
            <limiter name="CPUFreqMax" value="728000" />
            <limiter name="GPUFreqMax" value="260000" />
            <limiter name="Brightness" value="50" />
        </scenario>

        <scenario name="HeadMountedTheater" tempType="AP">
            <limiter name="CPUFreqMax" temp="450:605:610" value="-1:289250:30468" />
            <limiter name="GPUFreqMax" temp="450:605:610" value="-1:260000:200000" />
            <limiter name="HmtLevel" temp="450:605:610" value="-1:1:2" />
        </scenario>

        <scenario name="HeadMountedTheater_2" tempType="AP">
            <limiter name="CPUFreqMax" temp="450:600:610" value="-1:289250:30468" />
            <limiter name="GPUFreqMax" temp="450:600:610" value="-1:260000:200000" />
            <limiter name="HmtLevel" temp="450:600:610" value="-1:1:2" />
        </scenario>

        <scenario name="OverheatComplexControlForLowTemp" tempType="AP" priority="2" >
            <limiter name="WifiTput"    value="10" />
            <limiter name="HotspotTput" value="10" />
        </scenario>

        <scenario name="OverheatComplexControl" tempType="AP" priority="3" >
            <limiter name="WifiTput"    value="10"  />
            <limiter name="HotspotTput" value="1"   />
            <limiter name="Brightness"  value="116" />
            <limiter name="MaxVolume"   value="13"  />
        </scenario>

        <scenario name="EarlySIP" tempType="AP" priority="1">
            <limiter name="CPUFreqMax" temp="480:500" value="-1:1560000" />
        </scenario>

        <scenario name="SIP" tempType="AP*BAT" priority="1">
            <limiter name="CPUFreqMax" temp="480.0:500.0:520.360:530.380" value="-1:1560000:1456000:1378000" />
        </scenario>

        <scenario_group name="GameThermalCpuControl" tempType="AP" >
            <scenario id="-7"  limiter="CPUFreqMax"                             value="728000" />
            <scenario id="-6"  limiter="CPUFreqMax" step="0" temp="480:490:510" value="-1:1378000:728000" />
            <scenario id="-5"  limiter="CPUFreqMax" step="0" temp="480:490:510" value="-1:1378000:819000" />
            <scenario id="-4"  limiter="CPUFreqMax" step="0" temp="480:490:510" value="-1:1378000:936000" />
            <scenario id="-3"  limiter="CPUFreqMax" step="0" temp="480:490:510" value="-1:1378000:1040000" />
            <scenario id="-2"  limiter="CPUFreqMax" step="0" temp="480:490:510" value="-1:1378000:1144000" />
            <scenario id="-1"  limiter="CPUFreqMax" step="0" temp="480:490:510" value="-1:1378000:1248000" />
            <scenario id="0"   limiter="CPUFreqMax" step="0" temp="480:490:510" value="-1:1456000:1378000" />
            <scenario id="1"   limiter="CPUFreqMax" step="0" temp="480:490:510" value="-1:1560000:1456000" />
            <scenario id="2"   limiter="CPUFreqMax" step="0" temp="480:490:510" value="-1:1664000:1560000" />
            <scenario id="3"   limiter="CPUFreqMax" step="0" temp="480:490:510" value="-1:1820000:1664000" />
            <scenario id="4"   limiter="CPUFreqMax"                             value="-1" />
            <scenario name="BackgroundCpuset" temp="490:510:530" value="100:200:300" />
        </scenario_group>

        <scenario_group name="GameThermalGpuControl" tempType="AP" >
            <scenario id="-3" limiter="GPUFreqMax"                             value="260000" />
            <scenario id="-2" limiter="GPUFreqMax" step="0" temp="480:490:510" value="-1:325000:260000" />
            <scenario id="-1" limiter="GPUFreqMax" step="0" temp="480:490:510" value="-1:377000:325000" />
            <scenario id="0"  limiter="GPUFreqMax" step="0" temp="480:490:510" value="-1:433000:377000" />
            <scenario id="1"  limiter="GPUFreqMax" step="0" temp="480:490:510" value="-1:572000:433000" />
            <scenario id="2"  limiter="GPUFreqMax" step="0" temp="480:490:510" value="-1:650000:572000" />
            <scenario id="3"  limiter="GPUFreqMax"                             value="-1" />
        </scenario_group>

    </scenarios>

</siop_document>